# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Solo servidor (rutas API). Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Integración n8n / DIAN ---
# Secreto compartido que n8n envía en el header "x-webhook-secret" al llamar /api/dian/webhook
DIAN_WEBHOOK_SECRET=change-me
# Token Bearer requerido para llamar /api/billing/emit
BILLING_API_TOKEN=change-me
# Webhook de n8n que genera el XML UBL 2.1, lo firma y lo envía a la DIAN
N8N_BILLING_WEBHOOK_URL=https://n8n.example.com/webhook/dian-emit
# "habilitacion" (set de pruebas) o "production"
DIAN_ENVIRONMENT=habilitacion
