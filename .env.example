# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Solo servidor (rutas API). Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Integración n8n / DIAN ---
# Secreto compartido que n8n envía en el header "x-webhook-secret" al llamar /api/dian/webhook
DIAN_WEBHOOK_SECRET=change-me
# Token Bearer requerido para llamar /api/billing/emit
BILLING_API_TOKEN=change-me
# Webhook de n8n que genera el XML UBL 2.1, lo firma y lo envía a la DIAN
N8N_BILLING_WEBHOOK_URL=https://n8n.example.com/webhook/dian-emit
# "habilitacion" (set de pruebas) o "production"
DIAN_ENVIRONMENT=habilitacion

# --- Maqueta publicada ---
# Si se define, el navegador pide usuario y clave antes de entrar (dejar vacío en local).
DEMO_USER=dieselpro
DEMO_PASSWORD=

# --- Datos reales en Google Sheets ---
# Si las tres están definidas, la herramienta lee y guarda en esa hoja. Si falta alguna,
# funciona con datos de prueba en memoria.
# ID de la hoja: lo que va entre /d/ y /edit en su dirección.
GOOGLE_SHEETS_ID=
# Correo de la cuenta de servicio (…@….iam.gserviceaccount.com). La hoja se comparte con él como Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Valor "private_key" del archivo JSON de la cuenta de servicio, completo (con BEGIN/END).
GOOGLE_PRIVATE_KEY=

# --- Inicio de sesión ---
# Contraseña del administrador: entra con el usuario "admin". Si está vacía, la pantalla de
# entrada deja elegir un rol sin contraseña (solo para pruebas locales).
ADMIN_PASSWORD=
# Llave para firmar las sesiones (texto largo al azar). Si se cambia, todos deben volver a entrar.
SESSION_SECRET=
